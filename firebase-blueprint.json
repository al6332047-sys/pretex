{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile authenticated via Firebase Google Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Smart applications generated and saved by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "model": { "type": "string" },
        "code": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "userId", "title", "code"]
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
